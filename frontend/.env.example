# Las variables VITE_* son públicas. Nunca colocar secretos aquí.

# Base URL for all API requests.
# - Local dev (relative path): requests go through Vite's proxy to http://127.0.0.1:5000
# - Remote dev or production (absolute URL): requests go directly to that origin
#   VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=/api
